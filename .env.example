# Copy to .env and fill in. .env is gitignored -- never commit real values.

# ---------------------------------------------------------------- upstream
CCPROXY_UPSTREAM_URL=https://api.llm.cib.echonet/v1/openai
CCPROXY_UPSTREAM_API_KEY=

# ------------------------------------------------------------ model tiers
# Which upstream model backs each Claude Code tier. Claude Code sends dated
# model ids (claude-sonnet-4-5-20250929); the tier is matched on substring,
# so these keep working when Anthropic ships new dated ids.
#
# Note: Claude Code routes almost every turn through the SONNET tier. Opus is
# used only when explicitly selected, haiku for background summarisation.
CCPROXY_MODEL_OPUS=gemma-4-31b-ITG
CCPROXY_MODEL_SONNET=qwen-latest
CCPROXY_MODEL_HAIKU=qwen-3-coder-next

# Tier used when a request matches no tier at all.
CCPROXY_DEFAULT_TIER=sonnet

# Optional: exact model-id overrides, applied before tier matching.
# JSON object of {requested_model_id: upstream_model_id}.
# CCPROXY_MODEL_MAP={"claude-opus-4-6": "llama3.3-70b"}

# --------------------------------------------------------------------- TLS
# system  : OS trust store -- Windows CertStore / macOS Keychain (default)
# certifi : bundled certifi roots
# insecure: verification off. Diagnosis only; refused unless ALLOW_INSECURE=1
CCPROXY_TLS=system
# CCPROXY_CA_BUNDLE=C:\path\to\corp-ca.pem
# CCPROXY_ALLOW_INSECURE=0

# ------------------------------------------------------------------- serve
CCPROXY_HOST=127.0.0.1
CCPROXY_PORT=8787
CCPROXY_LOG_LEVEL=info

# Upstream request timeout in seconds. Agent turns on a loaded gateway can be
# slow; this is deliberately generous.
CCPROXY_TIMEOUT=600

# ---------------------------------------------------------- context window
# The gateway counts input + output against ONE total. Claude Code assumes
# Anthropic's shape (large input window, output budgeted separately) and will
# request 64000 output tokens on top of a 198k prompt. max_tokens is clamped
# to whatever is actually left.
CCPROXY_CONTEXT_WINDOW=262144

# Per-model overrides, when models differ.
# CCPROXY_CONTEXT_WINDOWS={"gemma-4-31b-ITG": 131072, "qwen-latest": 262144}

# Headroom for the token estimate being wrong plus the server's chat template.
CCPROXY_TOKEN_MARGIN=3072

# Below this, the prompt is reported as too long so Claude Code compacts.
CCPROXY_MIN_OUTPUT_TOKENS=512

# Optional hard ceiling on output tokens. 0 = no extra cap.
CCPROXY_MAX_OUTPUT_TOKENS=0
